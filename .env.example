# Odyssey environment. Copy to .env and fill in. Never commit .env.

# ---- Run mode -------------------------------------------------------------
# stack = full docker compose (postgres/redis/qdrant/langfuse)
# local = single process, SQLite + Chroma, no Docker
ODYSSEY_MODE=local
ODYSSEY_ENV=dev
ODYSSEY_LOG_LEVEL=INFO
ODYSSEY_LOG_JSON=true

# ---- LLM provider ---------------------------------------------------------
# groq | ollama | openai
ODYSSEY_LLM_PROVIDER=groq
ODYSSEY_LLM_MODEL=llama-3.3-70b-versatile
ODYSSEY_LLM_TEMPERATURE=0.3
# Groq (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=
# Ollama (when running local open weights)
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI-compatible endpoint (vLLM / TGI / OpenRouter / Together)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Persistence ----------------------------------------------------------
# In local mode these are ignored in favor of SQLite files under ./data
DATABASE_URL=postgresql+psycopg://odyssey:odyssey@localhost:5432/odyssey
SQLITE_PATH=./data/odyssey.sqlite
CHECKPOINT_SQLITE_PATH=./data/checkpoints.sqlite
REDIS_URL=redis://localhost:6379/0

# ---- Vector store ---------------------------------------------------------
# qdrant (stack) | chroma (local)
VECTOR_BACKEND=chroma
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=odyssey_knowledge
CHROMA_PATH=./data/chroma
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Tool API keys (all optional; tools degrade gracefully) ---------------
# OpenTripMap free key: https://opentripmap.io/product  (falls back to Overpass)
OPENTRIPMAP_API_KEY=
NOMINATIM_USER_AGENT=odyssey-dev (contact: you@example.com)

# ---- Observability --------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Auth / security ------------------------------------------------------
JWT_SECRET=change-me-in-production-please-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440
RATE_LIMIT_PER_MINUTE=60

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
